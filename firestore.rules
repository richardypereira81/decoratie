rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, create, update: if isSelf(uid);
      allow delete: if false;
    }

    match /produtos/{produtoId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /categorias/{categoriaId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /conteudo/{documentId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /configuracoes/{documentId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /segredos/{documentId} {
      allow read, write: if false;
    }

    match /notificacoes_estoque/{notificationId} {
      allow create: if true;
      allow read, update, delete: if isSignedIn();
    }

    match /cupons/{cupomId} {
      allow read, write: if isSignedIn();
    }

    match /clientes/{clienteId} {
      allow read, write: if isSignedIn();
    }

    match /clienteChaves/{chaveId} {
      allow read, write: if isSignedIn();
    }

    match /cupomUsos/{usoId} {
      allow read, write: if isSignedIn();
    }

    match /cupomUsoChaves/{chaveId} {
      allow read, write: if isSignedIn();
    }

    match /pedidos/{pedidoId} {
      allow create: if true;
      allow read, update, delete: if isSignedIn();
    }

    match /agendamentos/{agendamentoId} {
      allow read, write: if isSignedIn();
    }

    match /importacoes/{importacaoId} {
      allow read, write: if isSignedIn();

      match /itens/{itemId} {
        allow read, write: if isSignedIn();
      }

      match /arquivos/{arquivoId} {
        allow read, write: if isSignedIn();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
